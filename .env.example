# Copy to .env.local and fill in. Never commit real values.

# Public URL of this site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Empty when the app lives in this project; set only if the app is on another domain
NEXT_PUBLIC_APP_URL=

# MongoDB connection string (replica set / Atlas required for transactions)
MONGODB_URI=

# Secrets: generate with `openssl rand -base64 48` (AUTH_SECRET),
# `openssl rand -base64 32` (ENCRYPTION_KEY, must decode to 32 bytes), `openssl rand -hex 24` (CRON_SECRET)
AUTH_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# First admin account, used only by `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Brevo webhook secret. Webhook URL: https://YOUR-DOMAIN/api/webhooks/brevo?token=<this value>
BREVO_WEBHOOK_SECRET=
